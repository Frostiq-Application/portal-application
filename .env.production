# ============================================================================
#  portal-application (admin & super-admin portal) — PRODUCTION environment
#
#  Loaded by `npm run build:production` (vite build --mode production), which
#  is what the Dockerfile runs. Nothing reads this file at runtime: every value
#  below is BAKED INTO THE JS BUNDLE at build time.
#
#  On Railway, VITE_API_BASE_URL can be supplied as a build variable — the
#  Dockerfile declares it as an ARG and it overrides the value here. Everything
#  else comes from this file.
#
#  Only VITE_-prefixed vars reach the browser, and all of them are public by
#  design. No secrets belong here.
# ============================================================================

# ---- API -------------------------------------------------------------------
# Production service-application. The portal's own domain
# (https://admin.frostique.pronttera.com) must appear in the API's CORS_ORIGIN
# allow-list in service-application/.env.prod, or every request is blocked by
# the browser before it is ever sent.
VITE_API_BASE_URL=https://frostique-server.pronttera.com/api/v1

# ---- Storefront domain -----------------------------------------------------
# Used to build the public shop link shown next to a slug — a shop with slug
# "my-bakery" is displayed as https://frostique.in/my-bakery. Display only:
# changing it does not move any storefront, it just changes what the portal
# tells the bakery their address is. Keep it equal to the domain the
# client-application builds are actually served from.
VITE_STOREFRONT_HOST=frostique.in

# ---- Razorpay --------------------------------------------------------------
# Deliberately NOT configured. Billing checkout receives its key id from the
# API (`razorpayKeyId` on the checkout session), so the portal always follows
# whatever mode the backend is in — no test/live key can drift out of sync and
# none is baked into the bundle.
#
# The checkout modal is loaded at runtime from
# https://checkout.razorpay.com/v1/checkout.js — behind a CSP, that host plus
# api.razorpay.com and lumberjack.razorpay.com must be allowed.
