# Only VITE_-prefixed vars are exposed to the browser bundle. No secrets here.

# API base URL of the frostique service-application.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Storefront domain shown in the live slug preview on the signup page
# (e.g. "my-bakery" -> my-bakery.frostique.in). Default: frostique.in
VITE_STOREFRONT_HOST=frostique.in

# ---- Razorpay --------------------------------------------------------------
# Deliberately NOT configured here. Billing checkout gets its key id from the
# API (`razorpayKeyId` on the checkout session), so the portal always uses
# whatever mode the backend is in — no test/live key can drift out of sync,
# and no key is baked into the bundle at build time.
# The checkout modal script is loaded at runtime from
# https://checkout.razorpay.com/v1/checkout.js — if you deploy behind a CSP,
# that host (plus api.razorpay.com and lumberjack.razorpay.com) must be allowed.
